{
  "version": 1,
  "description": "Session-key, checksum and AES-128-CBC bundle decryption vectors. Ciphertexts are produced like the Capgo CLI: AES key RSA privateEncrypt (PKCS#1 v1.5), bundle AES-128-CBC with PKCS#7 padding. `publicKeyPem: null` in an input means \"use the fixture key\".",
  "publicKeyPem": "-----BEGIN RSA PUBLIC KEY-----\nMIIBCgKCAQEAtITiB7/jysdzu1KWHSQt88e50JAu9+SmEEeiTUiKJWCK5dfC7B+A\nahPOlVHxs/Q3vflJACUrEad7bVvflPzjllnG+ZJko+S8w96FU/pADY51WX6vW84r\norNQ0dTT1f4DHaqtHa6lkcM3QX7u9sKdu3/W5EOpY8vUvJyctgucROHUfTd0G9BG\nJvy3OaSEFgihWJJUrsiDq8iCm5x+OODumiz+n4nMoIegmswMDkOw/pb+9q/QRRO2\nUIvRbFiAogMzhLak/OOVothHdvNnKBZMAHJHsneNcjjvTAo5WecfZariLkX0tpft\nqy5r9jinLUO+FVL4yZ0qJjHcF9OuAo8eWwIDAQAB\n-----END RSA PUBLIC KEY-----",
  "sessionKeyValid": [
    {
      "id": "session-key.valid",
      "input": {
        "sessionKey": "aXY=:a2V5"
      },
      "expect": {
        "valid": true
      }
    },
    {
      "id": "session-key.empty",
      "input": {
        "sessionKey": ""
      },
      "expect": {
        "valid": false
      }
    },
    {
      "id": "session-key.colon-only",
      "input": {
        "sessionKey": ":"
      },
      "expect": {
        "valid": false
      }
    },
    {
      "id": "session-key.missing-key",
      "input": {
        "sessionKey": "aXY=:"
      },
      "expect": {
        "valid": false
      }
    },
    {
      "id": "session-key.missing-iv",
      "input": {
        "sessionKey": ":a2V5"
      },
      "expect": {
        "valid": false
      }
    },
    {
      "id": "session-key.three-parts",
      "input": {
        "sessionKey": "a:b:c"
      },
      "expect": {
        "valid": false
      }
    },
    {
      "id": "session-key.no-separator",
      "input": {
        "sessionKey": "abc"
      },
      "expect": {
        "valid": false
      }
    }
  ],
  "keyId": [
    {
      "id": "key-id.fixture",
      "input": {
        "publicKey": "-----BEGIN RSA PUBLIC KEY-----\nMIIBCgKCAQEAtITiB7/jysdzu1KWHSQt88e50JAu9+SmEEeiTUiKJWCK5dfC7B+A\nahPOlVHxs/Q3vflJACUrEad7bVvflPzjllnG+ZJko+S8w96FU/pADY51WX6vW84r\norNQ0dTT1f4DHaqtHa6lkcM3QX7u9sKdu3/W5EOpY8vUvJyctgucROHUfTd0G9BG\nJvy3OaSEFgihWJJUrsiDq8iCm5x+OODumiz+n4nMoIegmswMDkOw/pb+9q/QRRO2\nUIvRbFiAogMzhLak/OOVothHdvNnKBZMAHJHsneNcjjvTAo5WecfZariLkX0tpft\nqy5r9jinLUO+FVL4yZ0qJjHcF9OuAo8eWwIDAQAB\n-----END RSA PUBLIC KEY-----"
      },
      "expect": {
        "keyId": "MIIBCgKCAQEAtITiB7/j"
      }
    },
    {
      "id": "key-id.empty",
      "input": {
        "publicKey": ""
      },
      "expect": {
        "keyId": ""
      }
    },
    {
      "id": "key-id.short",
      "input": {
        "publicKey": "abc"
      },
      "expect": {
        "keyId": "abc"
      }
    },
    {
      "id": "key-id.crlf-and-spaces",
      "input": {
        "publicKey": "-----BEGIN RSA PUBLIC KEY-----\r\nMIIB CgKC\r\nAQEAqJikYizowR4jGct5\r\n-----END RSA PUBLIC KEY-----"
      },
      "expect": {
        "keyId": "MIIBCgKCAQEAqJikYizo"
      }
    }
  ],
  "publicKeyValid": [
    {
      "id": "public-key.fixture",
      "input": {
        "publicKey": null
      },
      "expect": {
        "valid": true
      }
    },
    {
      "id": "public-key.garbage",
      "input": {
        "publicKey": "-----BEGIN RSA PUBLIC KEY-----\nnot-base64!!\n-----END RSA PUBLIC KEY-----"
      },
      "expect": {
        "valid": false
      }
    },
    {
      "id": "public-key.not-a-key",
      "input": {
        "publicKey": "not-a-key"
      },
      "expect": {
        "valid": false
      }
    }
  ],
  "checksumAlgorithm": [
    {
      "id": "checksum-algorithm.empty",
      "input": {
        "checksum": ""
      },
      "expect": {
        "algorithm": "empty"
      }
    },
    {
      "id": "checksum-algorithm.sha256",
      "input": {
        "checksum": "02e69324016fdfff184910135b6581c076321b6bb403fee18fe31373edcda590"
      },
      "expect": {
        "algorithm": "SHA-256"
      }
    },
    {
      "id": "checksum-algorithm.crc32",
      "input": {
        "checksum": "deadbeef"
      },
      "expect": {
        "algorithm": "CRC32 (deprecated)"
      }
    },
    {
      "id": "checksum-algorithm.unknown",
      "input": {
        "checksum": "0123456789"
      },
      "expect": {
        "algorithm": "unknown (10 hex chars)"
      }
    }
  ],
  "checksumFile": [
    {
      "id": "checksum-file.empty",
      "input": {
        "contentHex": "",
        "repeat": 1
      },
      "expect": {
        "checksum": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
      }
    },
    {
      "id": "checksum-file.abc",
      "input": {
        "contentHex": "616263",
        "repeat": 1
      },
      "expect": {
        "checksum": "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
      }
    },
    {
      "id": "checksum-file.one-mebibyte-plus-one",
      "input": {
        "contentHex": "61",
        "repeat": 1048577
      },
      "expect": {
        "checksum": "4a3f0c0c213adea174f9a3d4c13177315b588bdb2e9c1012d3d0bf0453ca0f6a"
      }
    }
  ],
  "decryptChecksum": [
    {
      "id": "decrypt-checksum.hex-sha256",
      "input": {
        "publicKey": null,
        "checksum": ""
      },
      "expect": {
        "checksum": "02e69324016fdfff184910135b6581c076321b6bb403fee18fe31373edcda590"
      }
    },
    {
      "id": "decrypt-checksum.base64-legacy",
      "input": {
        "publicKey": null,
        "checksum": ""
      },
      "expect": {
        "checksum": "02e69324016fdfff184910135b6581c076321b6bb403fee18fe31373edcda590"
      }
    },
    {
      "id": "decrypt-checksum.crc32-payload",
      "input": {
        "publicKey": null,
        "checksum": ""
      },
      "expect": {
        "checksum": "deadbeef"
      }
    },
    {
      "id": "decrypt-checksum.no-public-key-passthrough",
      "input": {
        "publicKey": "",
        "checksum": "not-encrypted"
      },
      "expect": {
        "checksum": "not-encrypted"
      }
    },
    {
      "id": "decrypt-checksum.wrong-size",
      "input": {
        "publicKey": null,
        "checksum": ""
      },
      "expect": {
        "error": "checksum_not_encrypted"
      }
    },
    {
      "id": "decrypt-checksum.not-rsa-block",
      "input": {
        "publicKey": null,
        "checksum": ""
      },
      "expect": {
        "error": "decrypt_failed"
      }
    }
  ],
  "decryptFile": [
    {
      "id": "decrypt-file.small",
      "input": {
        "publicKey": null,
        "sessionKey": "8ODQwLCgkIBwYFBAMCAQAA==:",
        "ciphertextHex": "53c70de3fe81651a1970fd18cb7f2f29"
      },
      "expect": {
        "plaintextHex": "68656c6c6f20636170676f"
      }
    },
    {
      "id": "decrypt-file.multi-block",
      "input": {
        "publicKey": null,
        "sessionKey": "8ODQwLCgkIBwYFBAMCAQAA==:",
        "ciphertextHex": ""
      },
      "expect": {
        "plaintextHex": ""
      }
    },
    {
      "id": "decrypt-file.no-public-key-noop",
      "input": {
        "publicKey": "",
        "sessionKey": "8ODQwLCgkIBwYFBAMCAQAA==:",
        "ciphertextHex": "53c70de3fe81651a1970fd18cb7f2f29"
      },
      "expect": {
        "plaintextHex": "53c70de3fe81651a1970fd18cb7f2f29"
      }
    },
    {
      "id": "decrypt-file.no-session-key-noop",
      "input": {
        "publicKey": null,
        "sessionKey": "",
        "ciphertextHex": "53c70de3fe81651a1970fd18cb7f2f29"
      },
      "expect": {
        "plaintextHex": "53c70de3fe81651a1970fd18cb7f2f29"
      }
    },
    {
      "id": "decrypt-file.invalid-session-key-noop",
      "input": {
        "publicKey": null,
        "sessionKey": "nocolon",
        "ciphertextHex": "53c70de3fe81651a1970fd18cb7f2f29"
      },
      "expect": {
        "plaintextHex": "53c70de3fe81651a1970fd18cb7f2f29"
      }
    },
    {
      "id": "decrypt-file.spki-public-key-noop",
      "input": {
        "publicKey": "-----BEGIN PUBLIC KEY-----\nAAAA\n-----END PUBLIC KEY-----",
        "sessionKey": "8ODQwLCgkIBwYFBAMCAQAA==:",
        "ciphertextHex": "53c70de3fe81651a1970fd18cb7f2f29"
      },
      "expect": {
        "plaintextHex": "53c70de3fe81651a1970fd18cb7f2f29"
      }
    },
    {
      "id": "decrypt-file.short-iv",
      "input": {
        "publicKey": null,
        "sessionKey": "AQEBAQEBAQE=:",
        "ciphertextHex": "53c70de3fe81651a1970fd18cb7f2f29"
      },
      "expect": {
        "error": "invalid_iv"
      }
    },
    {
      "id": "decrypt-file.garbage-session-key",
      "input": {
        "publicKey": null,
        "sessionKey": "8ODQwLCgkIBwYFBAMCAQAA==:",
        "ciphertextHex": "53c70de3fe81651a1970fd18cb7f2f29"
      },
      "expect": {
        "error": "session_key_decrypt_failed"
      }
    },
    {
      "id": "decrypt-file.session-key-too-long",
      "input": {
        "publicKey": null,
        "sessionKey": "8ODQwLCgkIBwYFBAMCAQAA==:",
        "ciphertextHex": "53c70de3fe81651a1970fd18cb7f2f29"
      },
      "expect": {
        "error": "invalid_session_key"
      }
    },
    {
      "id": "decrypt-file.bad-padding",
      "input": {
        "publicKey": null,
        "sessionKey": "8ODQwLCgkIBwYFBAMCAQAA==:",
        "ciphertextHex": "53c70de3fe81651a1970fd18cb7f2fd6"
      },
      "expect": {
        "error": "decrypt_failed"
      }
    },
    {
      "id": "decrypt-file.not-block-aligned",
      "input": {
        "publicKey": null,
        "sessionKey": "8ODQwLCgkIBwYFBAMCAQAA==:",
        "ciphertextHex": "53c70de3fe81651a1970fd18cb7f2f"
      },
      "expect": {
        "error": "decrypt_failed"
      }
    },
    {
      "id": "decrypt-file.empty-ciphertext",
      "input": {
        "publicKey": null,
        "sessionKey": "8ODQwLCgkIBwYFBAMCAQAA==:",
        "ciphertextHex": ""
      },
      "expect": {
        "error": "empty_input"
      }
    }
  ]
}
