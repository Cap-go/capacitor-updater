  "contentRange": [
    {
      "id": "content-range.full",
      "input": {
        "header": "bytes 0-99/100"
      },
      "expect": {
        "range": {
          "start": 0,
          "end": 99,
          "total": 100
        }
      }
    },
    {
      "id": "content-range.unknown-total",
      "input": {
        "header": "bytes 100-199/*"
      },
      "expect": {
        "range": {
          "start": 100,
          "end": 199,
          "total": -1
        }
      }
    },
    {
      "id": "content-range.padded",
      "input": {
        "header": "  bytes 0-9/10  "
      },
      "expect": {
        "range": {
          "start": 0,
          "end": 9,
          "total": 10
        }
      }
    },
    {
      "id": "content-range.inner-spaces",
      "input": {
        "header": "bytes  0 - 9 / 10"
      },
      "expect": {
        "range": {
          "start": 0,
          "end": 9,
          "total": 10
        }
      }
    },
    {
      "id": "content-range.missing",
      "input": {
        "header": null
      },
      "expect": {
        "range": null
      }
    },
    {
      "id": "content-range.empty",
      "input": {
        "header": ""
      },
      "expect": {
        "range": null
      }
    },
    {
      "id": "content-range.wrong-unit",
      "input": {
        "header": "items 0-1/2"
      },
      "expect": {
        "range": null
      }
    },
    {
      "id": "content-range.reversed",
      "input": {
