{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>Cap-go/.github:renovate-config"
  ],
  "swift": {
    "enabled": false
  },
  "packageRules": [
    {
      "matchPackageNames": [
        "eslint"
      ],
      "matchManagers": [
        "npm"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "ZipArchive"
      ],
      "matchManagers": [
        "swift",
        "cocoapods"
      ],
      "enabled": false
    },
    // Specific rule to disable androidx.work:work-runtime updates to prevent kotlin version conflicts
    {
      "matchPackageNames": [
        "androidx.work:work-runtime"
      ],
      "matchManagers": [
        "gradle"
      ],
      "enabled": false
    },
    // Lifecycle 2.11 requires compileSdk 37 and Android Gradle plugin 9.1 through atomic group alignment
    {
      "matchPackageNames": [
        "androidx.lifecycle:lifecycle-process"
      ],
      "matchManagers": [
        "gradle"
      ],
      "enabled": false
    },
    // OkHttp 5 is binary-incompatible with the 4.x line. Gradle resolves one OkHttp
    // version per app, so a 5.x pin forces every host-app library that uses OkHttp 4.x
    // onto OkHttp 5 and breaks it at runtime. Hold this dependency on the 4.x line.
    {
      "matchPackagePatterns": [
        "^com\\.squareup\\.okhttp3:"
      ],
      "matchManagers": [
        "gradle"
      ],
      "allowedVersions": "/^4\\./"
    }
  ]
}
